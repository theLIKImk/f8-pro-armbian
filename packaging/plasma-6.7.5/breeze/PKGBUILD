# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgbase=breeze
pkgname=(breeze
         breeze-cursors)
pkgver=6.7.5
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1.1
arch=(aarch64)
pkgdesc='Artwork, styles and assets for the Breeze visual style for the Plasma Desktop'
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(breeze-icons
         frameworkintegration
         glibc
         kcmutils
         kcolorscheme
         kconfig
         kcoreaddons
         kdecoration
         kguiaddons
         ki18n
         kiconthemes
         kirigami
         kwidgetsaddons
         kwindowsystem
         libstdc++
         qt6-base
         qt6-declarative
         qt6-svg)
makedepends=(extra-cmake-modules)
optdepends=('breeze-gtk: Breeze widget style for GTK applications'
            'breeze5: Breeze widget style for Qt5 applications')
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz{,.sig})
sha256sums=('aa05c0c31c852ed5b137327e7798fd763a54c643875d5d8070625475e0af6976'
            'SKIP')
validpgpkeys=('0AAC775BB6437A8D9AF7A3ACFE0784117FBCE11D')

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF \
    -DBUILD_QT5=OFF
  cmake --build build


}

package_breeze() {
  depends+=(breeze-cursors)

  DESTDIR="$pkgdir" cmake --install build
# Split cursors
  rm -r "$pkgdir"/usr/share/icons/{breeze_cursors,Breeze_Light}
}

package_breeze-cursors() {
  pkgdesc='Breeze cursors'
  depends=()
  optdepends=()

  DESTDIR="$pkgdir" cmake --install build/cursors
  rm -r "$pkgdir"/usr/bin
}
