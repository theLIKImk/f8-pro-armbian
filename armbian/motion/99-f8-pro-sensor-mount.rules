# F8-PRO S1: correct the observed 180-degree screen orientation offset.
# Override SensorProxy only; raw IIO axes and gyroscope calibration are unchanged.
SUBSYSTEM=="iio", KERNEL=="iio:device*", ATTR{name}=="mpu6500", KERNELS=="3-0068", TEST=="/sys/firmware/devicetree/base/chosen/f8-motion-trial", ENV{ACCEL_MOUNT_MATRIX}="0,-1,0;-1,0,0;0,0,-1"
