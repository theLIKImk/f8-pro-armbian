#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
fail() {
    echo "F8 NATIVE DESKTOP T1 INIT STOP: $*" >/dev/kmsg 2>/dev/null || true
    if [ -f /run/f8/eval-logs.img ]; then /bin/sh /f8-evaluation-report init-failed || true; fi
    while :; do sleep 60; done
}
mkdir -p /dev /proc /sys /run
mount -t devtmpfs devtmpfs /dev || fail devtmpfs
mount -t proc proc /proc || fail proc
mount -t sysfs sysfs /sys || fail sysfs
mount -t tmpfs -o mode=0755,nosuid tmpfs /run || fail tmpfs
mkdir -p /run/f8 /mnt/root
cp /f8-firstboot-logs.img /run/f8/eval-logs.img || fail log-image
exec >/run/f8/evaluation-steps.log 2>&1
echo 'F8 NATIVE DESKTOP T1 init, verified writable root UUID required'
[ "$(uname -r)" = '6.1.115-vendor-rk35xx' ] || fail kernel-release
case " $(cat /proc/cmdline) " in *' systemd.gpt_auto=0 '*) ;; *) fail gpt-auto-policy;; esac
attempt=0
while [ ! -b /dev/mmcblk0p6 ] && [ "$attempt" -lt 30 ]; do sleep 1; attempt=$((attempt+1)); done
[ -b /dev/mmcblk0p6 ] || fail root-device
[ "$(blkid -s PARTUUID -o value /dev/mmcblk0p6)" = '614e0000-0000-4b53-8000-1d28000054a9' ] || fail root-partition
[ "$(blkid -s UUID -o value /dev/mmcblk0p6)" = '@ROOT_UUID@' ] || fail root-filesystem-uuid
mount -t ext4 -o rw /dev/mmcblk0p6 /mnt/root || fail mount-root
[ -f /mnt/root/etc/f8-pro-native-desktop-t1 ] || fail native-root-marker
[ -x /mnt/root/usr/lib/systemd/systemd ] || fail systemd
[ -s /mnt/root/usr/lib/modules/6.1.115-vendor-rk35xx/modules.dep ] || fail module-release
echo 'Native Armbian root verified; root filesystem writable, partition table unchanged'
moved=
for fs in dev proc sys run; do
    mkdir -p "/mnt/root/$fs"
    if ! mount --move "/$fs" "/mnt/root/$fs"; then
        for prior in $moved; do mount --move "/mnt/root/$prior" "/$prior" || true; done
        fail "move-$fs"
    fi
    moved="$fs $moved"
done
cd /mnt/root || fail chdir
exec switch_root /mnt/root /usr/lib/systemd/systemd --unit=f8-desktop.target --log-level=info
