[Unit]
Description=F8 deferred calibrated CPU DVFS on the full-performance boot
After=sddm.service ssh.service f8-desktop-hardware.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 12
ExecStart=/usr/local/lib/f8-pro/performance-startup.py cpu
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=f8-desktop.target
