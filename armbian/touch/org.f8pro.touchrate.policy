<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
 <vendor>F8-PRO</vendor>
 <action id="org.f8pro.touchrate.control">
  <description>Adjust F8 touchscreen reporting rate</description>
  <description xml:lang="zh_CN">调整 F8 触摸上报率</description>
  <message>Administrator authentication is required to change the touchscreen configuration.</message>
  <message xml:lang="zh_CN">修改全局触摸配置需要管理员验证。</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/f8-pro/touch-rate-control.py</annotate>
 </action>
</policyconfig>
