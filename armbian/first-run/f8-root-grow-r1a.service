[Unit]
Description=Expand F8 R1 ext4 to the verified existing p6 boundary
ConditionPathExists=/etc/f8-pro-release-r1
After=f8-live-prepare.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/f8-pro/root-grow-r1a.py
RemainAfterExit=yes
TimeoutStartSec=15min

[Install]
WantedBy=f8-desktop.target
